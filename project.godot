; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Crônicas de Aetheria"
config/description="Uma lenda de espada, sementes e mana."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.03, 0.04, 0.03, 1)
boot_splash/show_image=false

[autoload]

Game="*res://scripts/game.gd"
Sfx="*res://scripts/audio.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1


[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/fallback_to_d3d12=true
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=false
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=false
scaling_3d/mode=0
scaling_3d/scale=1.0
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=48
environment/ssao/quality=1
environment/ssao/half_size=true
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.02, 1)
mesh_lod/lod_change/threshold_pixels=2.0
